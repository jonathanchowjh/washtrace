{
  "name": "washtrace",
  "version": "0.1.0",
  "private": true,
  "description": "NFT wash trading detector. A polling worker and an API, in one container.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:web": "vitest run --project web",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck": "npm run -w @washtrace/detect build && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json && npm run -w @washtrace/web typecheck",
    "check": "npm run typecheck && npm test && npm run test:web",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "npm run --workspace @washtrace/web dev",
    "worker": "npm run --workspace @washtrace/worker dev",
    "stored": "npm run --workspace @washtrace/worker build && node apps/worker/dist/stored.js",
    "migrate": "npm run --workspace @washtrace/worker build && node apps/worker/dist/migrate.js",
    "publish:hub": "npm run --workspace @washtrace/worker build && node --env-file-if-exists=.env apps/worker/dist/publish-main.js",
    "db:up": "./scripts/dev-db.sh up",
    "db:down": "./scripts/dev-db.sh down",
    "db:psql": "./scripts/dev-db.sh psql"
  },
  "keywords": [
    "nft",
    "wash-trading",
    "ethereum",
    "seaport",
    "blur",
    "fraud",
    "graph"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}

# Copy to .env. Values here are the starting values; the console's Settings page
# can change them. Nothing here is required to start; without an RPC nothing is
# read, and without an Etherscan key SCC AU and AC report themselves not run.

# One JSON-RPC URL per chain, WASHTRACE_RPC_<chainId>. Any provider (Alchemy,
# Infura, QuickNode) or your own node. Finding a collection's deployment block
# needs archive state; give fromBlock when adding it if yours has none.
WASHTRACE_RPC_1=
# WASHTRACE_RPC_8453=

# Etherscan API V2: one key for every chain. https://etherscan.io/apidashboard
WASHTRACE_ETHERSCAN_KEY=
# Calls a second. The free plan allows 5.
# WASHTRACE_ETHERSCAN_RPS=4

# HTTP basic auth over every page and API route but /api/health. Set both or neither.
# Without it, settings can be saved only from this machine.
# WASHTRACE_USERNAME=
# WASHTRACE_PASSWORD=

# Hops of money the worker follows out of a trader, so SCC AU can see a
# payment routed back through wallets that never traded. 0 reads traders only.
# WASHTRACE_FOLLOW_HOPS=3

# Hugging Face, for reading datasets off the Hub (NFT-70M is public and needs
# none). Not read by washtrace itself. https://huggingface.co/settings/tokens
# HF_TOKEN=
